# ─── Django ───────────────────────────────────────────────────────────────────
# Générer : python -c "import secrets; print(secrets.token_hex(50))"
DJANGO_SECRET_KEY=change-me-generate-with-python-secrets
ALLOWED_HOSTS=localhost,127.0.0.1,votre-domaine.com
CORS_ALLOWED_ORIGINS=http://localhost:3000,https://votre-domaine.com

# ─── PostgreSQL ───────────────────────────────────────────────────────────────
DB_NAME=dmn_bu
DB_USER=dmn
DB_PASSWORD=change-me-strong-password
DB_HOST=localhost
DB_PORT=5432

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ─── Meilisearch ──────────────────────────────────────────────────────────────
MEILI_URL=http://localhost:7700
MEILI_MASTER_KEY=change-me-strong-random-key
MEILI_ENV=development

# ─── MinIO ────────────────────────────────────────────────────────────────────
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-me-strong-password
MINIO_BUCKET=dmn-documents
MINIO_ENDPOINT=localhost:9000

# ─── Email ────────────────────────────────────────────────────────────────────
# SEND_REAL_EMAILS=True  → envoie via SMTP (requiert EMAIL_HOST_USER + EMAIL_HOST_PASSWORD)
# SEND_REAL_EMAILS=False → affiche les emails dans les logs (développement)
SEND_REAL_EMAILS=False
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=votre@gmail.com
EMAIL_HOST_PASSWORD=votre-app-password-16-chars
DEFAULT_FROM_EMAIL=noreply@budmnucad.sn

# ─── Next.js ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000/api
