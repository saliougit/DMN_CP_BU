# Référence du format attendu par docker-compose.prod.yml en production.
# Ce fichier n'est PAS utilisé tel quel sur le VPS : .env.production y est
# entièrement régénéré à chaque déploiement par le workflow GitHub Actions
# (.github/workflows/deploy.yml), à partir des secrets du repo GitHub -
# voir deploy/ci/README.md pour la liste exacte et deploy/README.md pour
# le fonctionnement général. Ne jamais éditer .env.production à la main
# sur le serveur : le prochain déploiement l'écrase.

DJANGO_SETTINGS_MODULE=dmn_bu.settings.production

# Django
DJANGO_SECRET_KEY=CHANGE_ME_WITH_A_LONG_RANDOM_SECRET
ALLOWED_HOSTS=api-bnumerique.dmnucad.com,bnumerique.dmnucad.com
CORS_ALLOWED_ORIGINS=https://bnumerique.dmnucad.com

# PostgreSQL
DB_NAME=dmn_bu
DB_USER=dmn_bu
DB_PASSWORD=CHANGE_ME_DB_PASSWORD
DB_HOST=db
DB_PORT=5432

# Redis (pas d'exposition réseau hors du réseau Docker interne - pas de mot de passe nécessaire)
REDIS_URL=redis://redis:6379/0

# Meilisearch
MEILI_URL=http://search:7700
MEILI_MASTER_KEY=CHANGE_ME_MEILI_MASTER_KEY

# Email - boîte Hostinger dédiée (contacts@dmnucad.com), config identique à
# DMN_DEV (smtp.hostinger.com, port 465 SSL implicite). Si bloqué en sortie
# du VPS, passer à EMAIL_PORT=587 / EMAIL_USE_TLS=True / EMAIL_USE_SSL=False.
SEND_REAL_EMAILS=True
EMAIL_HOST=smtp.hostinger.com
EMAIL_PORT=465
EMAIL_USE_TLS=False
EMAIL_USE_SSL=True
EMAIL_HOST_USER=contacts@dmnucad.com
EMAIL_HOST_PASSWORD=CHANGE_ME_HOSTINGER_MAILBOX_PASSWORD
DEFAULT_FROM_EMAIL=DMN Bibliothèque Numérique <contacts@dmnucad.com>

FRONTEND_URL=https://bnumerique.dmnucad.com

# MinIO (stockage objet - documents). MINIO_ENDPOINT = nom du service Docker
# (connexion interne backend -> MinIO, rapide). MINIO_PUBLIC_ENDPOINT = sous-
# domaine public (nginx sur l'hôte + certificat), utilisé uniquement pour
# générer les URLs renvoyées au frontend/navigateur.
MINIO_ROOT_USER=CHANGE_ME_MINIO_USER
MINIO_ROOT_PASSWORD=CHANGE_ME_MINIO_PASSWORD
MINIO_BUCKET=dmn-bu-documents
MINIO_ENDPOINT=storage:9000
MINIO_PUBLIC_ENDPOINT=storage-bnumerique.dmnucad.com

# Frontend (build arg Next.js - voir frontend/Dockerfile, compilé dans le
# bundle JS au build, pas lu à l'exécution)
NEXT_PUBLIC_API_URL=https://api-bnumerique.dmnucad.com/api
